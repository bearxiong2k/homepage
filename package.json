{
  "name": "paper-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa-library.mjs",
    "validate": "node scripts/validate-library.mjs",
    "new:paper": "node scripts/scaffold-paper.mjs",
    "sync:citation-metadata": "node scripts/sync-bibtex-display-metadata.mjs",
    "sync:marginalia": "rsync -a --delete --exclude '.DS_Store' ../Marginalia/public/ public/marginalia/",
    "sync:marginalia:check": "node scripts/hooks/check-marginalia-sync.mjs",
    "export:atlas": "node scripts/export-atlas-manifest.mjs",
    "export:atlas:check": "node scripts/export-atlas-manifest.mjs --check",
    "contract:website": "node scripts/check-website-contract.mjs",
    "smoke:website": "node scripts/website-devkit-smoke.mjs",
    "hook:precommit": "node scripts/hooks/run-homepage-checks.mjs precommit",
    "hook:prepush": "node scripts/hooks/run-homepage-checks.mjs prepush",
    "precommit": "npm run hook:precommit",
    "prepush": "npm run hook:prepush",
    "codex:checkpoint": "node scripts/hooks/run-homepage-checks.mjs codex",
    "hooks:install": "node scripts/hooks/install-git-hooks.mjs"
  },
  "dependencies": {
    "astro": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest"
  }
}
